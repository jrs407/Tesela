# Copia este fichero a .env (git lo ignora) y ajusta los valores.
# docker compose lo lee solo; todas las variables tienen valor por defecto.

# MongoDB
MONGO_DATABASE=tesela
MONGO_REPLICA_SET=rs0
MONGO_PORT=27017

# Puertos publicados en el host
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Origenes permitidos por CORS (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Pendiente para la fase 1 (autenticacion):
# JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
